# Copia a .env y cambia los valores. Nunca subas .env a Git.
VISION_ENVIRONMENT=development
VISION_DATABASE_URL=postgresql+psycopg://vision:CAMBIAR@localhost:5434/vision
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
VISION_SECRET_KEY=CAMBIAR
# Claves que usa el backend de Carpetazo para crear sesiones (separadas por coma)
VISION_SERVICE_API_KEYS=CAMBIAR
POSTGRES_PASSWORD=CAMBIAR
