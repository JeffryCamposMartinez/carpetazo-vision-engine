# Copia este archivo a .env (scripts\dev\setup.ps1 lo hace) y reemplaza los valores CAMBIAR.
# Nunca subas .env a Git. Usa credenciales de DESARROLLO, jamás las de producción.
VISION_ENVIRONMENT=development

# PostgreSQL NATIVO con una base exclusiva de desarrollo (ver docs/postgres-windows.md).
VISION_DATABASE_URL=postgresql+psycopg://vision_dev:CAMBIAR@127.0.0.1:5432/vision_dev

# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
VISION_SECRET_KEY=CAMBIAR
# Claves que usa el backend de Carpetazo para crear sesiones (separadas por coma)
VISION_SERVICE_API_KEYS=CAMBIAR

# Pruebas de integración con PostgreSQL (opcional). Base *_test EXCLUSIVA: en cada prueba se borra su esquema.
# VISION_TEST_POSTGRES_URL=postgresql+psycopg://vision_dev:CAMBIAR@127.0.0.1:5432/vision_test
# Solo si el servidor NO tiene pgvector: valida lo relacional con un relleno, NO valida pgvector.
# VISION_TEST_ALLOW_VECTOR_STUB=1

# Importador TCGdex (opcional): un contacto para que el proveedor pueda escribirte si hace falta.
# VISION_PROVIDER_CONTACT=correo@ejemplo.com

# Almacenamiento de imágenes (opcional). Por defecto: disco local en ./datasets/images
# VISION_IMAGE_STORAGE_BACKEND=local
# Cloudflare R2 (solo lectura en las herramientas actuales): credenciales de DESARROLLO desde variables de entorno
# VISION_IMAGE_STORAGE_BACKEND=s3
# VISION_R2_ACCOUNT_ID=CAMBIAR
# VISION_S3_BUCKET=CAMBIAR
# VISION_S3_ACCESS_KEY_ID=CAMBIAR
# VISION_S3_SECRET_ACCESS_KEY=CAMBIAR

# Solo para el docker-compose.yml OPCIONAL (no hace falta para desarrollar):
# POSTGRES_PASSWORD=CAMBIAR
